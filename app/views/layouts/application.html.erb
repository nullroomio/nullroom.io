<!DOCTYPE html>
<html lang="en" data-env="<%= Rails.env %>" data-commit-sha="<%= commit_sha %>">
  <head>
    <% title = content_for?(:title) ? yield(:title) : "Nullroom | Private Encrypted Chat Room, No Sign-Up, No Logs" %>
    <% description = content_for?(:description) ? yield(:description) : "Free end-to-end encrypted chat room in your browser. No account, no app, no logs. Post-quantum safe, peer-to-peer messages and files that vanish when you close the tab." %>
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <% if content_for?(:robots) %>
      <meta name="robots" content="<%= yield(:robots) %>">
    <% else %>
      <link rel="canonical" href="<%= canonical_url %>">
    <% end %>

    <%# Open Graph & Twitter Cards %>
    <meta property="og:site_name" content="nullroom">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="<%= content_for?(:og_type) ? yield(:og_type) : "website" %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= Nullroom::Config::CANONICAL_ORIGIN %>/icon.png">
    <meta name="twitter:card" content="summary">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="nullroom">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://nullroom.io/#organization",
          "name": "nullroom",
          "url": "https://nullroom.io/",
          "logo": "https://nullroom.io/icon.png",
          "sameAs": ["https://github.com/nullroomio/nullroom.io"]
        },
        {
          "@type": "WebSite",
          "@id": "https://nullroom.io/#website",
          "name": "nullroom",
          "alternateName": ["Nullroom", "null room", "nullroom.io"],
          "url": "https://nullroom.io/",
          "publisher": { "@id": "https://nullroom.io/#organization" }
        },
        {
          "@type": "WebApplication",
          "@id": "https://nullroom.io/#app",
          "name": "nullroom",
          "url": "https://nullroom.io/",
          "applicationCategory": "CommunicationApplication",
          "operatingSystem": "Web browser",
          "browserRequirements": "Requires a modern browser with WebRTC and Web Crypto support.",
          "isAccessibleForFree": true,
          "offers": {
            "@type": "Offer",
            "price": "0.00",
            "priceCurrency": "USD"
          },
          "description": "A post-quantum zero-knowledge encrypted messaging platform immune to Harvest Now, Decrypt Later.",
          "publisher": { "@id": "https://nullroom.io/#organization" }
        }
      ]
    }
    </script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Propshaft asset manifest for client-side integrity verification %>
    <script type="application/json" id="integrity-manifest"><%= integrity_manifest_json.html_safe %></script>
  </head>

  <body class="bg-null-deep font-sans antialiased">
    <main>
      <%= yield %>
    </main>
    <%= render "shared/integrity_indicator" %>
  </body>
</html>
