<%# ── Room Show ─────────────────────────────────────────────────────── %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow, noarchive">
<% end %>

<div
  class="relative w-full h-dvh flex flex-col items-center py-6 px-4"
  data-controller="room"
  data-room-room-id-value="<%= @room_id %>"
  data-room-turn-servers-value="<%= @ice_servers.to_json %>"
  data-room-room-ttl-seconds-value="<%= @room_ttl_seconds %>"
>

  <%# ── Top nav ─────────────────────────────────────────────────────── %>
  <%# Connection status lives in the card's status bar (single source of truth). %>
  <header class="w-full max-w-lg flex items-center mb-6">
    <%= render "shared/logo", size: "sm" %>
  </header>

  <%# ── Glass card ──────────────────────────────────────────────────── %>
  <div class="glass w-full max-w-lg flex-1 min-h-0 max-h-[760px] flex flex-col overflow-hidden">

    <%# ── Status bar ──────────────────────────────────────────────────── %>
    <div class="flex items-center justify-between px-5 py-3 border-b border-white/8">
      <div class="flex items-center gap-2">
        <div
          data-room-target="statusDot"
          class="w-2.5 h-2.5 rounded-full bg-yellow-400 animate-pulse"
        ></div>
        <span
          data-room-target="statusText"
          class="text-xs font-mono text-secure-gray tracking-widest uppercase"
          title="Finding the most secure path..."
        >NEGOTIATING...</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-1.5 font-mono tabular-nums">
          <span class="text-xs text-secure-gray">Expires in</span>
          <span
            data-room-target="timerDisplay"
            class="text-sm text-trace-white"
          >--:--</span>
        </span>
        <button
          data-action="room#destroyRoom"
          aria-label="Destroy room"
          title="Destroy room - ends the session for both participants"
          class="shrink-0 p-1.5 rounded-lg border border-red-800/60 text-red-400/70 hover:text-red-400 hover:bg-red-950/50 hover:border-red-700 active:scale-95 transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-red-500 cursor-pointer"
        >
          <%= render "shared/icon", name: "trash", css: "w-3.5 h-3.5" %>
        </button>
      </div>
    </div>

    <%# ── Room link (privacy shroud by default) ───────────────────────── %>
    <div data-room-target="inviteSection" class="px-5 py-4 border-b border-white/8">
      <p class="text-xs font-mono text-secure-gray mb-2">
        Room Link
        <span class="text-white/30">(click-to-reveal)</span>
      </p>
      <div class="flex items-center gap-2">
        <input
          data-room-target="shareLink"
          type="text"
          readonly
          value="<%= request.url %>"
          aria-label="Room link"
          class="privacy-shroud flex-1 min-w-0 px-3 py-2 rounded-lg bg-white/5 border border-white/8 text-trace-white text-xs font-mono focus:outline-none focus:border-status-blue hover:border-white/20 transition-colors"
          data-action="click->room#revealLink"
        />
        <button
          data-action="room#copyLink"
          aria-label="Copy link"
          class="shrink-0 p-2 rounded-lg bg-white/5 border border-white/8 text-secure-gray hover:text-trace-white hover:border-white/20 active:scale-95 transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-status-blue cursor-pointer"
        >
          <%= render "shared/icon", name: "clipboard", css: "w-4 h-4" %>
        </button>
        <button
          data-action="room#showQR"
          aria-label="Show QR code"
          class="shrink-0 p-2 rounded-lg bg-white/5 border border-white/8 text-secure-gray hover:text-trace-white hover:border-white/20 active:scale-95 transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-status-blue cursor-pointer"
        >
          <%= render "shared/icon", name: "qr-code", css: "w-4 h-4" %>
        </button>
      </div>

      <%# ── Short-Code Handshake (share via 4-word phrase) ─────────────── %>
      <div data-controller="handshake" class="mt-3">
        <button
          data-action="handshake#share"
          data-handshake-target="shareButton"
          class="w-full px-3 py-2 rounded-lg bg-white/5 border border-white/8 text-secure-gray text-xs font-mono hover:text-trace-white hover:border-white/20 active:scale-95 transition-all cursor-pointer"
        >
          Share via Code
        </button>
        <div
          data-handshake-target="phraseDisplay"
          class="hidden mt-2 px-3 py-2 rounded-lg bg-emerald-950/40 border border-emerald-500/30"
        >
          <p class="text-[10px] font-mono text-secure-gray mb-1">Share this code (expires in 5 min):</p>
          <div class="flex items-center gap-2">
            <code
              data-handshake-target="phraseText"
              class="flex-1 text-sm font-mono text-emerald-400 select-all"
            ></code>
            <button
              data-action="handshake#copyPhrase"
              class="shrink-0 p-1.5 rounded border border-white/10 text-secure-gray hover:text-trace-white active:scale-95 transition-all cursor-pointer"
              aria-label="Copy code"
            >
              <%= render "shared/icon", name: "clipboard", css: "w-3.5 h-3.5" %>
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# ── Messages area ────────────────────────────────────────────────── %>
    <div
      data-room-target="messagesContainer"
      class="flex-1 min-h-0 overflow-y-auto px-5 py-4 space-y-2"
    >
      <div data-room-target="bootLogContainer"></div>
      <div data-room-target="waitingPlaceholder" class="flex flex-col items-center text-center py-16">
        <p class="text-sm font-sans text-trace-white">Room ready - waiting for peer to join</p>
        <p class="text-xs font-mono text-secure-gray mt-2 leading-relaxed">
          Share the link above to invite a peer.
        </p>
      </div>
    </div>

    <%# ── Message input & actions ──────────────────────────────────────── %>
    <%# Drag-and-drop file support spans the whole composer; attach button + %>
    <%# native picker stay inline with the text field (revealed once P2P+file_sharing). %>
    <div
      class="px-5 py-4 border-t border-white/8"
      data-action="dragover->room#preventDrop drop->room#handleDrop"
    >
      <%# Negative margin reclaims most of the container's px-5 so the text field %>
      <%# spans wider; progress bar / size hint below stay aligned at px-5. %>
      <div class="flex items-center gap-2 -mx-3">
        <%# Attach file — hidden until P2P connected + file_sharing enabled %>
        <button
          data-room-target="fileZone"
          data-action="room#triggerFileInput"
          aria-label="Attach a file"
          title="Attach a file"
          class="hidden shrink-0 p-2.5 rounded-lg bg-white/5 border border-white/8 text-secure-gray hover:text-trace-white hover:border-white/20 active:scale-95 transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-status-blue cursor-pointer"
        >
          <%= render "shared/icon", name: "paperclip", css: "w-4 h-4" %>
        </button>
        <%# Native file picker — triggered programmatically by the attach button %>
        <input
          data-room-target="fileInput"
          data-action="change->room#uploadFile"
          type="file"
          class="hidden"
          tabindex="-1"
          aria-hidden="true"
        />
        <input
          data-room-target="messageInput"
          type="text"
          placeholder="Type a message..."
          disabled
          class="flex-1 min-w-0 px-4 py-2.5 rounded-lg bg-white/5 border border-white/8 text-trace-white text-sm font-sans placeholder-secure-gray focus:outline-none focus:border-status-blue disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
          data-action="keydown.enter->room#sendMessage"
        />
        <button
          data-room-target="sendButton"
          data-action="room#sendMessage"
          disabled
          aria-label="Send message"
          class="shrink-0 p-2.5 rounded-lg bg-status-blue text-white hover:brightness-110 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-status-blue cursor-pointer"
        >
          <%= render "shared/icon", name: "send", css: "w-4 h-4" %>
        </button>
      </div>

      <%# Progress bar (hidden until a transfer is in flight) %>
      <div data-room-target="fileProgress" class="hidden mt-2 space-y-1">
        <span
          data-room-target="fileProgressLabel"
          class="block text-xs font-mono text-secure-gray truncate"
        >Transferring…</span>
        <div class="h-1 bg-white/10 rounded-full overflow-hidden">
          <div
            data-room-target="fileProgressBar"
            class="h-full w-0 bg-status-blue rounded-full transition-all duration-200"
          ></div>
        </div>
      </div>

      <%# File-size limit hint — populated by JS once the connection type is known. %>
      <p
        data-room-target="fileSizeLabel"
        class="text-left text-[10px] font-mono text-secure-gray/50 mt-1.5 -ml-3 empty:hidden"
      ></p>
    </div>

  </div><%# /glass card %>

  <%# ── Room Terminated Modal (initially hidden) ─────────────────────── %>
  <div
    data-room-target="terminatedModal"
    class="hidden fixed inset-0 bg-null-deep/80 backdrop-blur-sm flex items-center justify-center z-50 px-4"
  >
    <div class="glass w-full max-w-sm p-8 text-center space-y-5">
      <div class="w-12 h-12 mx-auto rounded-full border border-red-800/60 flex items-center justify-center text-red-400">
        <%= render "shared/icon", name: "trash", css: "w-6 h-6" %>
      </div>
      <div>
        <h2 class="font-sans font-semibold text-trace-white text-lg">Room Terminated</h2>
        <p class="mt-2 text-sm font-sans text-secure-gray leading-relaxed">
          One participant left. All traces are now cleared.
        </p>
      </div>
      <button
        data-action="room#closeRoom"
        class="w-full px-6 py-3 rounded-lg border border-red-800/60 text-red-400 text-sm font-sans font-semibold hover:bg-red-950/50 active:scale-95 transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500 cursor-pointer"
      >
        Close
      </button>
    </div>
  </div>

  <%# ── QR Code Modal (initially hidden) ──────────────────────────── %>
  <div
    data-room-target="qrModal"
    data-action="click->room#closeQR"
    class="hidden fixed inset-0 bg-null-deep/80 backdrop-blur-sm flex items-center justify-center z-50 px-4"
  >
    <div class="glass w-full max-w-xs p-6 text-center space-y-4" data-action="click->room#stopPropagation">
      <p class="text-xs font-mono text-secure-gray tracking-widest uppercase">Scan to Join</p>
      <div class="flex items-center justify-center">
        <canvas data-room-target="qrCanvas" class="rounded-lg"></canvas>
      </div>
      <button
        data-action="room#closeQR"
        class="w-full px-4 py-2 rounded-lg border border-white/10 text-secure-gray text-xs font-mono hover:text-trace-white hover:border-white/20 active:scale-95 transition-all cursor-pointer"
      >
        Close
      </button>
    </div>
  </div>

  <%# ── Error Toast (initially hidden) ─────────────────────────────── %>
  <div
    data-room-target="errorToast"
    class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-red-950/90 backdrop-blur-md border border-red-800/60 text-red-300 px-5 py-3 text-xs font-mono rounded-lg shadow-lg z-50"
  >
    <span data-room-target="errorToastText"></span>
  </div>

  <%# ── Brand sparkle mark ─────────────────────────────────────────── %>
  <div class="fixed bottom-6 right-6 text-trace-white/20 pointer-events-none" aria-hidden="true">
    <%= render "shared/icon", name: "sparkle", css: "w-8 h-8" %>
  </div>

</div>
